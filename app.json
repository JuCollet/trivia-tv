{
  "expo": {
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/images/tv/android-banner.png",
          "appleTVImages": {
            "icon": "./assets/images/tv/appletv-icon.png",
            "iconSmall": "./assets/images/tv/appletv-icon-small.png",
            "iconSmall2x": "./assets/images/tv/appletv-icon-small-2x.png",
            "topShelf": "./assets/images/tv/appletv-top-shelf.png",
            "topShelf2x": "./assets/images/tv/appletv-top-shelf-2x.png",
            "topShelfWide": "./assets/images/tv/appletv-top-shelf-wide.png",
            "topShelfWide2x": "./assets/images/tv/appletv-top-shelf-wide-2x.png"
          }
        }
      ],
      "./plugins/withSceneLifecycle",
      "./plugins/withoutSystemClickSound",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1260",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-router",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/lilita-one/400Regular/LilitaOne_400Regular.ttf",
            "node_modules/@expo-google-fonts/fredoka/400Regular/Fredoka_400Regular.ttf",
            "node_modules/@expo-google-fonts/fredoka/500Medium/Fredoka_500Medium.ttf",
            "node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/fredoka/700Bold/Fredoka_700Bold.ttf"
          ]
        }
      ]
    ],
    "android": {
      "package": "com.jucollet.triviatv",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon-background.png",
        "backgroundColor": "#0047B3"
      },
      "versionCode": 3
    },
    "ios": {
      "bundleIdentifier": "com.jucollet.trivia-tv"
    },
    "name": "Chacun Son Truc",
    "slug": "trivia-tv",
    "scheme": "chacunsontruc",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/tv"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "icon": "./assets/images/icon.png"
  }
}
